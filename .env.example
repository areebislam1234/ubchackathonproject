# Copy to .env and fill in. Never commit .env.
# Nothing here is needed for local play: `npm run dev` works with this file absent.

# ── Solana ──────────────────────────────────────────────────────────
# local   in-process Solana (LiteSVM) with real SPL programs, nothing to install (default)
# devnet  Solana devnet
NETWORK=local

# Devnet RPC: your QuickNode Solana Devnet endpoint (falls back to the public devnet RPC).
SOLANA_RPC_URL=

# The game authority that pays fees, owns the badge mints and writes memos.
# Leave blank and `npm run setup-solana` creates one in .data/<network>/authority.json.
# Or paste a 64-byte secret as a JSON array or base58.
SOLANA_AUTHORITY_KEY=

# Public URL of the game server. Wallets fetch badge metadata and images from here,
# so on devnet use your tunnel URL (cloudflared / ngrok).
PUBLIC_URL=http://localhost:4000

# ── QuickNode Streams ───────────────────────────────────────────────
# The Stream's "Security token". When set, webhooks without a valid x-qn-signature get 401.
QUICKNODE_WEBHOOK_SECRET=
# On devnet, set to 1 to poll the chain yourself while the Stream isn't set up yet.
USE_LOCAL_STREAM=

# Network sampling for crypto intel: the Stream filter summarises one block in every N slots.
STREAM_NETWORK_EVERY=50
# Token mints whose transfers are counted in those samples (comma-separated). Default: devnet USDC.
INTEL_WATCH_MINTS=

# ── Intelligence reports ────────────────────────────────────────────
# Boss loot can include reports built from live public data about one specific market:
# ESPN (sports), Open-Meteo (weather), Gemini (prices and odds), World Bank (economics),
# GDELT (headlines) and QuickNode (Solana). None of these needs a key.
# off = clearly labelled sample data only.
INTEL=on
# Optional: monthly US economic series instead of annual World Bank data (free key from FRED).
FRED_API_KEY=

# ── Gemini prediction markets ───────────────────────────────────────
# mock  local market server with a "settle" button for demos (default)
# live  real markets from https://api.gemini.com (public endpoints, no key needed)
GEMINI_MODE=mock
GEMINI_BASE_URL=

# ── Pacing and ports ────────────────────────────────────────────────
# How long bounties wait before battles open, and how long battles last (seconds).
BOUNTY_UPCOMING_SECONDS=
BOUNTY_ACTIVE_SECONDS=
# How many upcoming + active bounties to keep on the map.
BOUNTY_TARGET=14
# Dev panel for demos (edit gold, levels, spawn/settle bounties). Turn off before sharing publicly.
DEV_TOOLS=on
# Rival warlords (bots) that join bounties and attack. on | off
BOTS=on
GAME_PORT=4000
MOCK_GEMINI_PORT=4100
LOCAL_CHAIN_PORT=8899

# ── Odds history, movers and the town crier ─────────────────────────
# How often the server records every open Gemini market's price (seconds). Default: 10 with mock
# Gemini, 60 live. Gemini's API gives current prices only, so this history powers the odds charts.
ODDS_SAMPLE_SECONDS=
