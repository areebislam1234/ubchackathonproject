{
  "name": "stakeclash",
  "version": "0.1.0",
  "private": true,
  "description": "StakeClash: an 8-bit strategy game. Explore a huge world for blind bounties, battle rival warlords, then call the hidden Gemini prediction market. Badges on Solana, events via QuickNode Streams.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "test": "tsx scripts/e2e.ts",
    "server": "tsx server/index.ts",
    "mock-gemini": "tsx gemini/mock-server.ts",
    "local-chain": "tsx localchain/rpc.ts",
    "stream-relay": "tsx localchain/stream-relay.ts",
    "setup-solana": "tsx scripts/setup-solana.ts",
    "print-filter": "tsx scripts/print-filter.ts",
    "settle": "tsx scripts/settle.ts",
    "world-preview": "tsx scripts/world-preview.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@solana-program/memo": "^0.16.0",
    "@solana-program/system": "^0.16.0",
    "@solana-program/token": "^0.16.0",
    "@solana-program/token-2022": "^0.20.1",
    "@solana/kit": "^8.6.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "litesvm": "^1.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
